---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import Footer from '../components/Footer.astro'
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_SOCIAL_IMAGE,
  SITE_X_HANDLE,
  absoluteUrl,
  baseJsonLd,
} from '../lib/site'
import { markdownUrlFor } from '../lib/negotiation'
import { hreflangLinks, translationPair } from '../lib/alternates'

interface Props {
  title?: string
  description?: string
  lang?: string
  type?: 'website' | 'article'
  jsonLd?: Record<string, unknown>
  /** Skip the site footer (standalone pages like the CV). */
  bare?: boolean
  /** Social preview image (og:image, twitter:image); defaults to the site photo. */
  image?: string
  /**
   * The page has a markdown twin (built by src/pages/[...path]/index.md.ts),
   * so it advertises it with <link rel="alternate" type="text/markdown">.
   * Only set it from pages that endpoint covers.
   */
  markdownTwin?: boolean
  /**
   * Site path of this page in the other language. When set, the head carries
   * reciprocal hreflang alternates (en, pt-BR, x-default -> en); leave it unset
   * for pages without a translation.
   */
  alternate?: string | null
  /** Ask search engines not to index the page (links are still followed). */
  noindex?: boolean
  /** Wide page container (home). Inner pages keep the default. */
  wide?: boolean
}

const {
  title,
  description,
  lang = 'en',
  type = 'website',
  jsonLd,
  bare = false,
  image,
  markdownTwin = false,
  alternate,
  noindex = false,
  wide = false,
} = Astro.props
const vercelAnalytics = process.env.VERCEL === '1'
const htmlLang = lang === 'pt-br' ? 'pt-BR' : 'en'
const siteTitle = SITE_TITLE
const siteDescription = SITE_DESCRIPTION
const pageTitle = title ? `${title} - ${siteTitle}` : `${siteTitle} - ${siteDescription}`
const pageDescription = description || siteDescription
const canonicalPath = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://franklinjavier.com').href
const ogImage = absoluteUrl(image ?? SITE_SOCIAL_IMAGE, Astro.site)
const ogLocale = lang === 'pt-br' ? 'pt_BR' : 'en_US'
const pageLang = lang === 'pt-br' ? 'pt-br' : 'en'
const alternates = hreflangLinks(translationPair(pageLang, Astro.url.pathname, alternate))
const markdownUrl = markdownTwin ? markdownUrlFor(Astro.url.pathname) : undefined
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Franklin Javier" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="300" />}
    {!image && <meta property="og:image:height" content="300" />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content={SITE_X_HANDLE} />
    <meta name="twitter:creator" content={SITE_X_HANDLE} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(baseJsonLd(pageLang))} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      href={pageLang === 'pt-br' ? '/pt-br/rss.xml' : '/rss.xml'}
      hreflang={htmlLang}
      type="application/rss+xml"
      title="Feed"
    />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
    <slot name="head" />

    <script is:inline>
      /* prettier-ignore */
      ;(function(){var r=document.documentElement,s=localStorage.getItem('color-theme');r.classList.toggle('dark',s==='dark'||(s===null&&matchMedia('(prefers-color-scheme: dark)').matches));function boot(){var t=document.getElementById('theme-toggle'),m=document.getElementById('theme-toggle-dark-icon'),u=document.getElementById('theme-toggle-light-icon'),l=document.getElementById('language-toggle');function sync(){if(!m||!u)return;var on=r.classList.contains('dark');m.classList.toggle('hidden',on);u.classList.toggle('hidden',!on)}function apply(on){r.classList.toggle('dark',on);localStorage.setItem('color-theme',on?'dark':'light');sync()}function tog(){var go=function(){apply(!r.classList.contains('dark'))};if(document.startViewTransition&&!matchMedia('(prefers-reduced-motion: reduce)').matches){r.classList.add('theme-transition');try{document.startViewTransition(go).finished.finally(function(){r.classList.remove('theme-transition')})}catch(err){r.classList.remove('theme-transition');go()}}else go()}sync();if(t)t.addEventListener('click',tog);document.addEventListener('keydown',function(e){if(e.metaKey||e.ctrlKey||e.altKey)return;var n=document.activeElement&&document.activeElement.tagName;if(n==='INPUT'||n==='TEXTAREA')return;if(e.key==='t'&&t)tog();if(e.key==='l'&&l)location.href=l.href})}document.readyState==='loading'?document.addEventListener('DOMContentLoaded',boot):boot()})()
    </script>
  </head>
  <body class="min-h-screen bg-page text-ink antialiased transition-colors ease-smooth">
    <slot />
    {!bare && <Footer wide={wide} />}
    {vercelAnalytics && <Analytics />}
  </body>
</html>
