---
import '../styles/prose.css'
import BaseLayout from './BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import { getLangFromUrl, useTranslations, parseTags, formatDate, getTagUrl } from '../i18n/utils'
import { blogPostingJsonLd } from '../lib/site'

interface Props {
  title: string
  date: Date
  description?: string
  tags?: string | string[]
}

const { title, date, description, tags: rawTags } = Astro.props

const tags = parseTags(rawTags)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const formattedDate = formatDate(date, lang)
const jsonLd = blogPostingJsonLd({
  title,
  description,
  date,
  url: Astro.url.pathname,
  lang,
  tags,
})
---

<BaseLayout title={title} description={description} lang={lang} type="article" jsonLd={jsonLd}>
  <Navigation />

  <div class="pt-32 pb-20">
    <article class="mx-auto max-w-3xl px-8">
      <a
        href={blogUrl}
        class="mb-8 inline-block text-sm text-gray-500 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        ← {t('blog.backToBlog')}
      </a>

      <header class="mb-12">
        <h1 class="mb-4 text-5xl leading-tight font-bold">{title}</h1>
        <div class="flex flex-wrap items-center gap-4">
          <time class="text-sm text-gray-500 dark:text-gray-400">{formattedDate}</time>
          {
            tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={getTagUrl(tag, lang)}
                    class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
