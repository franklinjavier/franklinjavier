---
import '../styles/prose.css'
import BaseLayout from './BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import ImageViewer from '../components/ImageViewer.astro'
import {
  getLangFromUrl,
  useTranslations,
  parseTags,
  formatDate,
  getTagUrl,
  getPostTranslationUrl,
} from '../i18n/utils'
import { blogPostingJsonLd } from '../lib/site'

interface Props {
  title: string
  date: Date
  description?: string
  tags?: string | string[]
  image?: string
}

const { title, date, description, tags: rawTags, image } = Astro.props

const tags = parseTags(rawTags)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const formattedDate = formatDate(date, lang)
const translation = await getPostTranslationUrl(Astro.url, lang)
const flags = { en: '🇺🇸', 'pt-br': '🇧🇷' }
const jsonLd = blogPostingJsonLd({
  title,
  description,
  date,
  url: Astro.url.pathname,
  lang,
  tags,
  image,
})
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type="article"
  jsonLd={jsonLd}
  image={image}
>
  <Navigation />

  <main class="pt-24 pb-20">
    <article class="mx-auto max-w-3xl px-8">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
        <a
          href={blogUrl}
          class="text-gray-500 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
        >
          ← {t('blog.backToBlog')}
        </a>
        {translation && (
          <a
            href={translation.url}
            hreflang={translation.lang}
            lang={translation.lang}
            class="inline-flex items-center gap-2 text-gray-500 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
          >
            <span aria-hidden="true" class="text-base leading-none">
              {flags[translation.lang]}
            </span>
            {t('blog.readTranslation')}
          </a>
        )}
      </div>

      <header class="mb-12">
        <h1 class="mb-4 text-5xl leading-tight font-bold">{title}</h1>
        <div class="flex flex-wrap items-center gap-4">
          <time class="text-sm text-gray-500 dark:text-gray-400">{formattedDate}</time>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <a
                  href={getTagUrl(tag, lang)}
                  class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>

  <ImageViewer lang={lang} />
</BaseLayout>
