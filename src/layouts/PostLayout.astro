---
import BaseLayout from './BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import { getLangFromUrl, useTranslations, parseTags, formatDate, getTagUrl } from '../i18n/utils'
import { blogPostingJsonLd } from '../lib/site'
import {
  page,
  container3xl,
  backLink,
  header12,
  pageTitle,
  metaRow,
  mutedTime,
  tagRow,
  tag,
} from '../styles/app'

interface Props {
  title: string
  date: Date
  description?: string
  tags?: string | string[]
}

const { title, date, description, tags: rawTags } = Astro.props

const tags = parseTags(rawTags)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const formattedDate = formatDate(date, lang)
const jsonLd = blogPostingJsonLd({
  title,
  description,
  date,
  url: Astro.url.pathname,
  lang,
  tags,
})
---

<BaseLayout title={title} description={description} lang={lang} type="article" jsonLd={jsonLd}>
  <Navigation />

  <div class={page.class}>
    <article class={container3xl.class}>
      <a href={blogUrl} class={backLink.class}>
        ← {t('blog.backToBlog')}
      </a>

      <header class={header12.class}>
        <h1 class={pageTitle.class}>{title}</h1>
        <div class={metaRow.class}>
          <time class={mutedTime.class}>{formattedDate}</time>
          {
            tags.length > 0 && (
              <div class={tagRow.class}>
                {tags.map((item) => (
                  <a href={getTagUrl(item, lang)} class={tag.class}>
                    {item}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
