---
import '../styles/prose.css'
import BaseLayout from './BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import ImageViewer from '../components/ImageViewer.astro'
import TableOfContents from '../components/TableOfContents.astro'
import Sidenotes from '../components/Sidenotes.astro'
import HeadingAnchors from '../components/HeadingAnchors.astro'
import type { MarkdownHeading } from 'astro'
import { hasToc, type TocLabels } from '../lib/toc'
import {
  getLangFromUrl,
  useTranslations,
  parseTags,
  formatDate,
  getTagUrl,
  getPostTranslationUrl,
} from '../i18n/utils'
import { blogPostingJsonLd } from '../lib/site'
import { getRelatedPosts, getSeriesNav } from '../lib/content'
import { seriesMarker, seriesNextLabel, seriesPartLabel, type SeriesRef } from '../lib/series'

interface Props {
  title: string
  date: Date
  /** Last meaningful edit (`updated` frontmatter); `date` when absent. */
  updated?: Date
  description?: string
  tags?: string | string[]
  image?: string
  headings?: MarkdownHeading[]
  /** Short TOC labels from the post's `toc` frontmatter, keyed by heading slug. */
  tocLabels?: TocLabels
  /** Series membership from the post's `series` frontmatter. */
  series?: SeriesRef
  /** Estimated minutes to read the body (lib/reading-time). */
  readingTime?: number
}

const {
  title,
  date,
  updated,
  description,
  tags: rawTags,
  image,
  headings = [],
  tocLabels,
  series,
  readingTime,
} = Astro.props
const showToc = hasToc(headings)

const tags = parseTags(rawTags)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const formattedDate = formatDate(date, lang)
const translation = await getPostTranslationUrl(Astro.url, lang)
const seriesNav = await getSeriesNav(lang, series)
const relatedPosts = await getRelatedPosts(lang, Astro.url.pathname, rawTags)
const flags = { en: '🇺🇸', 'pt-br': '🇧🇷' }
const readingLabel = readingTime ? `${readingTime} ${t('blog.minRead')}` : undefined
const modified = updated ?? date
const jsonLd = blogPostingJsonLd({
  title,
  description,
  date,
  updated: modified,
  url: Astro.url.pathname,
  lang,
  tags,
  image,
})
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type="article"
  jsonLd={jsonLd}
  image={image}
  alternate={translation?.url}
  markdownTwin
>
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  <meta slot="head" property="article:modified_time" content={modified.toISOString()} />
  {/* The TOC list ships once, in the inline <details>; JS copies it into the
      lg+ rail. Without JS the rail stays empty, so keep the <details> there. */}
  {showToc && (
    <noscript slot="head">
      <style is:inline>
        @media (min-width: 64rem) {
          [data-toc-inline] {
            display: block;
          }
        }
      </style>
    </noscript>
  )}
  <Navigation />

  <main class="site-container pt-10 pb-24">
    {/* Text column on the shared container's left edge; on lg+ the TOC rail
        hangs in the left margin and footnotes float right as sidenotes
        (prose.css .post-grid). */}
    <div class="post-grid">
      <article data-toc-article={showToc || undefined} class="post-column">
        <div class="mb-6 flex min-h-5 flex-wrap items-center justify-between gap-x-4 gap-y-1 text-meta leading-5">
          <a
            href={blogUrl}
            class="text-muted transition-colors duration-200 ease-smooth hover:text-ink"
          >
            ← {t('blog.backToBlog')}
          </a>
          {translation && (
            <a
              href={translation.url}
              hreflang={translation.lang}
              lang={translation.lang}
              class="inline-flex items-center gap-1.5 text-muted transition-colors duration-200 ease-smooth hover:text-ink"
            >
              <span aria-hidden="true" class="text-sm leading-none">
                {flags[translation.lang]}
              </span>
              {t('blog.readTranslation')}
            </a>
          )}
        </div>

        <header class="mb-10">
          <h1 class="font-serif text-[1.625rem] leading-[1.2] font-medium tracking-[-0.01em] text-ink sm:text-[1.75rem]">
            {title}
          </h1>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-1.5 text-meta text-muted">
            <time datetime={date.toISOString()}>{formattedDate}</time>
            {tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {tags.map((tag, index) => (
                    <>
                      {index > 0 && ', '}
                      <a
                        href={getTagUrl(tag, lang)}
                        class="underline decoration-dotted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-solid"
                      >
                        {tag}
                      </a>
                    </>
                  ))}
                </span>
              </>
            )}
            {readingLabel && (
              <>
                <span aria-hidden="true">·</span>
                <span data-reading-time>{readingLabel}</span>
              </>
            )}
          </p>
          {seriesNav && (
            <nav aria-label={t('series.nav')} class="mt-1.5 text-meta text-muted">
              <p>{seriesMarker(seriesNav, lang)}</p>
              {seriesNav.previous && (
                <p class="mt-0.5">
                  <a
                    href={seriesNav.previous.url}
                    rel="prev"
                    class="transition-colors duration-200 ease-smooth hover:text-ink"
                  >
                    ← {seriesPartLabel(seriesNav.previous, lang)}
                  </a>
                </p>
              )}
            </nav>
          )}
        </header>

        <TableOfContents lang={lang} headings={headings} labels={tocLabels} variant="inline" />

        <HeadingAnchors lang={lang} headings={headings}>
          <div class="prose" data-sidenotes>
            <slot />
          </div>
        </HeadingAnchors>

        {seriesNav?.next && (
          <nav
            aria-label={t('series.navNext')}
            class="mt-12 border-t border-rule pt-5 text-meta text-muted"
          >
            <a
              href={seriesNav.next.url}
              rel="next"
              class="transition-colors duration-200 ease-smooth hover:text-ink"
            >
              {seriesNextLabel(seriesNav.next, lang)}
            </a>
          </nav>
        )}
        {relatedPosts.length > 0 && (
          <section
            aria-labelledby="related-posts"
            class="mt-12 border-t border-rule pt-5 text-meta text-muted"
          >
            <h2 id="related-posts" class="text-[10px] uppercase tracking-[0.08em]">{t('blog.relatedPosts')}</h2>
            <ul class="mt-3 space-y-2">
              {relatedPosts.map((post) => (
                <li>
                  <a
                    href={post.url}
                    class="transition-colors duration-200 ease-smooth hover:text-ink"
                  >
                    {post.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>

      {/* lg:pt-11 skips the back-link row (min-h-5 + mb-6) so the TOC starts level with the h1. */}
      {showToc && (
        <aside class="post-rail hidden lg:block lg:pt-11">
          <TableOfContents lang={lang} headings={headings} labels={tocLabels} variant="sidebar" />
        </aside>
      )}
    </div>
  </main>

  <Sidenotes />
  <ImageViewer lang={lang} />
</BaseLayout>
