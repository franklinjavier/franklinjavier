---
import '../styles/prose.css'
import BaseLayout from './BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import ImageViewer from '../components/ImageViewer.astro'
import TableOfContents from '../components/TableOfContents.astro'
import type { MarkdownHeading } from 'astro'
import { hasToc, type TocLabels } from '../lib/toc'
import {
  getLangFromUrl,
  useTranslations,
  parseTags,
  formatDate,
  getTagUrl,
  getPostTranslationUrl,
} from '../i18n/utils'
import { blogPostingJsonLd } from '../lib/site'

interface Props {
  title: string
  date: Date
  description?: string
  tags?: string | string[]
  image?: string
  headings?: MarkdownHeading[]
  /** Short TOC labels from the post's `toc` frontmatter, keyed by heading slug. */
  tocLabels?: TocLabels
}

const {
  title,
  date,
  description,
  tags: rawTags,
  image,
  headings = [],
  tocLabels,
} = Astro.props
const showToc = hasToc(headings)

const tags = parseTags(rawTags)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const formattedDate = formatDate(date, lang)
const translation = await getPostTranslationUrl(Astro.url, lang)
const flags = { en: '🇺🇸', 'pt-br': '🇧🇷' }
const jsonLd = blogPostingJsonLd({
  title,
  description,
  date,
  url: Astro.url.pathname,
  lang,
  tags,
  image,
})
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type="article"
  jsonLd={jsonLd}
  image={image}
  markdownTwin
>
  <Navigation />

  <main
    class:list={[
      'pt-24 pb-20',
      // Side columns around the unchanged max-w-3xl article; the right one holds the TOC.
      showToc && 'lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,48rem)_minmax(16rem,1fr)]',
    ]}
  >
    <article
      data-toc-article={showToc || undefined}
      class:list={['mx-auto max-w-3xl px-8', showToc && 'lg:col-start-2 lg:row-start-1 lg:mx-0']}
    >
      <div class="mb-8 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
        <a
          href={blogUrl}
          class="text-gray-500 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
        >
          ← {t('blog.backToBlog')}
        </a>
        {translation && (
          <a
            href={translation.url}
            hreflang={translation.lang}
            lang={translation.lang}
            class="inline-flex items-center gap-2 text-gray-500 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
          >
            <span aria-hidden="true" class="text-base leading-none">
              {flags[translation.lang]}
            </span>
            {t('blog.readTranslation')}
          </a>
        )}
      </div>

      <header class="mb-12">
        <h1 class="mb-4 text-5xl leading-tight font-bold">{title}</h1>
        <div class="flex flex-wrap items-center gap-4">
          <time class="text-sm text-gray-500 dark:text-gray-400">{formattedDate}</time>
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <a
                  href={getTagUrl(tag, lang)}
                  class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <TableOfContents lang={lang} headings={headings} labels={tocLabels} variant="inline" />

      <div class="prose">
        <slot />
      </div>
    </article>

    {/* lg:pt-13 skips the back-link row (h-5 + mb-8) so the TOC starts level with the h1. */}
    {
      showToc && (
        <aside class="hidden pr-6 lg:col-start-3 lg:row-start-1 lg:block lg:pt-13 lg:pl-6 xl:pl-14">
          <TableOfContents lang={lang} headings={headings} labels={tocLabels} variant="sidebar" />
        </aside>
      )
    }
  </main>

  <ImageViewer lang={lang} />
</BaseLayout>
