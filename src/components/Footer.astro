---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils'

interface Props {
  /** Home passes this so the bar matches the wide page container. */
  wide?: boolean
}

const { wide = false } = Astro.props
const container = wide ? 'site-container-wide' : 'site-container'
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const links = [
  { href: getLocalizedPath('/about/', lang), label: t('nav.about') },
  { href: getLocalizedPath('/cv/', lang), label: t('nav.cv') },
  { href: getLocalizedPath('/contact/', lang), label: t('nav.contact') },
  { href: getLocalizedPath('/privacy/', lang), label: t('nav.privacy') },
  { href: getLocalizedPath('/rss.xml', lang), label: 'RSS' },
]
---

<footer class="border-t border-rule">
  <div
    class={`${container} flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-8 text-meta text-muted`}
  >
    <p>© {new Date().getFullYear()} Franklin Javier</p>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map((link) => (
        <a
          href={link.href}
          class="underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
