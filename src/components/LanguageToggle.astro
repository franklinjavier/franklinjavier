---
import {
  getLangFromUrl,
  getAlternateUrl,
  getPostTranslationUrl,
  getTagUrl,
  getLocalizedPath,
  useTranslations,
} from '../i18n/utils'
import { translateTag } from '../lib/tags'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const lang = getLangFromUrl(Astro.url)
const targetLang = lang === 'pt-br' ? 'en' : 'pt-br'
// Label and code are in the target language, like the link's lang attribute.
const target = useTranslations(targetLang)

// Blog posts and tag pages have different slugs per language, so they map
// through the content and the tag allowlist; with no counterpart the link
// lands on the other language's blog index, never the home page.
const blogPath = Astro.url.pathname.replace(/^\/pt-br/, '')
const tagMatch = /^\/blog\/tag\/([^/]+)\/?$/.exec(blogPath)
const postMatch = /^\/blog\/(?!tag\/)[^/]+\/?$/.test(blogPath)
const targetBlog = getLocalizedPath('/blog/', targetLang)

let alternateUrl: string
if (tagMatch) {
  const tag = translateTag(decodeURIComponent(tagMatch[1]!), lang, targetLang)
  alternateUrl = tag ? getTagUrl(tag, targetLang) : targetBlog
} else if (postMatch) {
  alternateUrl = (await getPostTranslationUrl(Astro.url, lang))?.url ?? targetBlog
} else {
  alternateUrl = getAlternateUrl(Astro.url, targetLang)
}
---

<a
  id="language-toggle"
  href={alternateUrl}
  hreflang={targetLang}
  lang={targetLang}
  class:list={['text-meta tracking-[0.04em] text-muted', className]}
>
  {/* No aria-label: the name starts with the visible code (WCAG 2.5.3 label in
      name) and the hidden suffix spells out what it does. */}
  {[target('lang.short'), <span class="sr-only">, {target('lang.switch')}</span>]}
</a>
