---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, parseTags, getPostUrl } from '../i18n/utils'
import {
  page,
  container4xl,
  header16,
  backLinkTight,
  pageTitle,
  titleMuted,
  sectionLead,
  empty,
  emptyText,
  list,
  group,
  block,
  mutedTime,
  articleTitle,
  descriptionText,
  tagRowSpaced,
  tagStatic,
  readMoreGroup,
} from '../styles/app'

interface Props {
  lang: 'en' | 'pt-br'
  tag: string
}

const { lang, tag } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  if (data.draft === true || data.lang !== lang) return false

  const tags = parseTags(data.tags).map((t) => t.toLowerCase())
  return tags.includes(tag.toLowerCase())
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const title = `${t('blog.title')} - ${tag}`
const description = `${t('blog.postsTagged')} "${tag}"`

// Built here rather than interpolated across JSX lines: a line break between
// sibling expressions collapses the space between them.
const countLabel = `${sortedPosts.length} ${
  sortedPosts.length === 1 ? t('blog.articleCount') : t('blog.articlesCount')
}`
---

<BaseLayout title={title} description={description} lang={lang}>
  <Navigation />

  <main class={page.class}>
    <div class={container4xl.class}>
      <!-- Header -->
      <header class={header16.class}>
        <a href={lang === 'en' ? '/blog/' : '/pt-br/blog/'} class={backLinkTight.class}>
          ← {t('blog.backToBlog')}
        </a>
        <h1 class={pageTitle.class}>
          {t('blog.postsTagged')}{' '}
          <span class={titleMuted.class}>"{tag}"</span>
        </h1>
        <p class={sectionLead.class}>{countLabel}</p>
      </header>

      <!-- Posts list -->
      {
        sortedPosts.length === 0 ? (
          <div class={empty.class}>
            <p class={emptyText.class}>{t('blog.noPostsFound')}</p>
          </div>
        ) : (
          <div class={list.class}>
            {sortedPosts.map((post) => {
              const formattedDate = formatDate(post.data.date, lang)
              const postUrl = getPostUrl(post.id, lang)
              const tags = parseTags(post.data.tags)

              return (
                <article class={group.class}>
                  <a href={postUrl} class={block.class}>
                    <time class={mutedTime.class}>{formattedDate}</time>
                    <h2 class={articleTitle.class}>{post.data.title}</h2>
                    {post.data.description && (
                      <p class={descriptionText.class}>{post.data.description}</p>
                    )}
                    {tags.length > 0 && (
                      <div class={tagRowSpaced.class}>
                        {tags.map((item) => (
                          <span class={tagStatic.class}>{item}</span>
                        ))}
                      </div>
                    )}
                    <div class={readMoreGroup.class}>{t('blog.readMore')}</div>
                  </a>
                </article>
              )
            })}
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
