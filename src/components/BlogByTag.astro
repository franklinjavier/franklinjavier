---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, parseTags, getPostUrl } from '../i18n/utils'
import { viewTransitionName } from '../lib/view-transition'

interface Props {
  lang: 'en' | 'pt-br'
  tag: string
}

const { lang, tag } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  if (data.draft === true || data.lang !== lang) return false

  const tags = parseTags(data.tags).map((t) => t.toLowerCase())
  return tags.includes(tag.toLowerCase())
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const title = `${t('blog.title')} - ${tag}`
const description = `${t('blog.postsTagged')} "${tag}"`

// Built here rather than interpolated across JSX lines: a line break between
// sibling expressions collapses the space between them.
const countLabel = `${sortedPosts.length} ${
  sortedPosts.length === 1 ? t('blog.articleCount') : t('blog.articlesCount')
}`
---

{/* Thin listing pages: kept out of the index and the sitemap, links still followed. */}
<BaseLayout title={title} description={description} lang={lang} noindex markdownTwin>
  <Navigation />

  <main class="site-container pt-20 pb-24">
    <!-- Header -->
    <header class="mb-8">
      <a
        href={lang === 'en' ? '/blog/' : '/pt-br/blog/'}
        class="mb-6 inline-block text-meta text-muted transition-colors duration-200 ease-smooth hover:text-ink"
      >
        ← {t('blog.backToBlog')}
      </a>
      <h1 class="mb-2 text-[1.375rem] leading-tight font-[550] text-ink">
        {t('blog.postsTagged')} <span class="text-ink-2">"{tag}"</span>
      </h1>
      <p class="text-[0.8125rem] leading-5 text-muted">{countLabel}</p>
    </header>

    <!-- Posts list -->
    {sortedPosts.length === 0 ? (
      <div class="border-t border-rule py-10">
        <p class="text-muted">{t('blog.noPostsFound')}</p>
      </div>
    ) : (
      <div class="border-t border-rule">
        {sortedPosts.map((post) => {
          const formattedDate = formatDate(post.data.date, lang)
          const postUrl = getPostUrl(post.id, lang)
          const tags = parseTags(post.data.tags)

          return (
            <article class="group border-b border-rule py-5">
              <a href={postUrl} class="block">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-meta text-muted tabular-nums"
                  style={`view-transition-name: ${viewTransitionName('date', post.id)}`}
                >
                  {formattedDate}
                </time>
                <h2
                  class="mt-0.5 font-[550] text-ink decoration-muted underline-offset-3 group-hover:underline"
                  style={`view-transition-name: ${viewTransitionName('title', post.id)}`}
                >
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="mt-1 text-[0.8125rem] leading-5 text-ink-2">{post.data.description}</p>
                )}
                <p class="mt-2 flex flex-wrap items-baseline gap-x-1.5 text-meta text-muted">
                  {tags.length > 0 && (
                    <>
                      <span>{tags.join(', ')}</span>
                      <span aria-hidden="true">·</span>
                    </>
                  )}
                  <span class="transition-colors duration-200 ease-smooth group-hover:text-ink">
                    {t('blog.readMore')}
                  </span>
                </p>
              </a>
            </article>
          )
        })}
      </div>
    )}
  </main>
</BaseLayout>
