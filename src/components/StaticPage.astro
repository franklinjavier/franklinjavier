---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { page, article, header, title } from './StaticPage.stylex'

interface Props {
  lang: 'pt-br' | 'en'
  slug: 'about' | 'contact' | 'privacy'
}

const { lang, slug } = Astro.props
const entrySlug = lang === 'en' ? slug : `pt-br/${slug}`
const entry = await getEntry('pages', entrySlug)

if (!entry) {
  throw new Error(`Missing page content for "${entrySlug}"`)
}

const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang={lang}>
  <Navigation />

  <div class={page.class}>
    <article class={article.class}>
      <header class={header.class}>
        <h1 class={title.class}>{entry.data.title}</h1>
      </header>

      <div
        class="prose prose-lg dark:prose-invert prose-headings:font-bold prose-p:leading-relaxed prose-a:underline prose-a:decoration-1 prose-a:underline-offset-2 max-w-none"
      >
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
