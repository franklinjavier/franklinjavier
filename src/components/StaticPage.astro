---
import '../styles/prose.css'
import { getEntry, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { getAlternateUrl } from '../i18n/utils'

interface Props {
  lang: 'pt-br' | 'en'
  slug: 'about' | 'contact' | 'privacy'
}

const { lang, slug } = Astro.props
const entrySlug = lang === 'en' ? slug : `pt-br/${slug}`
const entry = await getEntry('pages', entrySlug)

if (!entry) {
  throw new Error(`Missing page content for "${entrySlug}"`)
}

const { Content } = await render(entry)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  alternate={getAlternateUrl(Astro.url, lang === 'en' ? 'pt-br' : 'en')}
  markdownTwin
>
  <Navigation />

  <main class="site-container pt-20 pb-24">
    <article>
      <header class="mb-8">
        <h1 class="text-[1.375rem] leading-tight font-[550] text-ink">{entry.data.title}</h1>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
