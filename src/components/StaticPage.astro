---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { page, container3xl, header12, pageTitlePlain } from '../styles/app'

interface Props {
  lang: 'pt-br' | 'en'
  slug: 'about' | 'contact' | 'privacy'
}

const { lang, slug } = Astro.props
const entrySlug = lang === 'en' ? slug : `pt-br/${slug}`
const entry = await getEntry('pages', entrySlug)

if (!entry) {
  throw new Error(`Missing page content for "${entrySlug}"`)
}

const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang={lang}>
  <Navigation />

  <div class={page.class}>
    <article class={container3xl.class}>
      <header class={header12.class}>
        <h1 class={pageTitlePlain.class}>{entry.data.title}</h1>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
