---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'

interface Props {
  lang: 'pt-br' | 'en'
  slug: 'about' | 'contact' | 'privacy'
}

const { lang, slug } = Astro.props
const entrySlug = lang === 'en' ? slug : `pt-br/${slug}`
const entry = await getEntry('pages', entrySlug)

if (!entry) {
  throw new Error(`Missing page content for "${entrySlug}"`)
}

const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang={lang}>
  <Navigation />

  <div class="pt-32 pb-20">
    <article class="max-w-3xl mx-auto px-8">
      <header class="mb-12">
        <h1 class="text-5xl font-bold leading-tight">{entry.data.title}</h1>
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none
        prose-headings:font-bold
        prose-p:leading-relaxed
        prose-a:underline prose-a:decoration-1 prose-a:underline-offset-2">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
