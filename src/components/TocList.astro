---
/**
 * The numbered link list behind both TableOfContents variants. It is rendered
 * once, in the inline (mobile) <details>; the sidebar script clones it into
 * the rail, so long posts don't ship the list twice.
 * Numbers are decorative (aria-hidden), so links are announced by text only.
 *
 * Without a `toc` frontmatter label, the full heading text (`toc-full`) is
 * the visible, truncated label and the link's name. With one, the short
 * label (`toc-short`) shows while compact and the full text stays visually
 * hidden, so the name reads "short: full" and contains whatever is visible
 * (label in name). The sidebar's expanded overlay swaps which one is visible
 * but keeps both in the name (TableOfContents styles both states). `title`
 * carries the full heading for the truncated inline copy; the rail clone
 * drops it.
 */
import type { TocItem } from '../lib/toc'

interface Props {
  items: TocItem[]
}

const { items } = Astro.props
---

<ol>
  {items.map((item) => (
    <li>
      <a
        href={`#${item.slug}`}
        title={item.text}
        data-depth={item.depth}
        class:list={[
          'toc-link group flex items-baseline gap-2 rounded-sm py-1 pr-1 leading-[1.125rem] text-muted hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink aria-[current=location]:text-ink',
          // h3 text lines up with h2 text (number column w-4 + gap-2). The rail
          // shifts both right of its progress line (TableOfContents styles).
          item.depth === 3 ? 'pl-6' : 'pl-0',
        ]}
      >
        {item.number && (
          <span
            aria-hidden="true"
            class="w-4 shrink-0 text-[0.6875rem] text-muted tabular-nums group-hover:text-ink-2 group-aria-[current=location]:text-ink-2"
          >
            {item.number}
          </span>
        )}
        {item.label === item.text ? (
          <span class="toc-full min-w-0 truncate">{item.text}</span>
        ) : (
          <>
            <span class="toc-short min-w-0 truncate">{item.label}</span>
            <span class="sr-only">: </span>
            <span class="toc-full sr-only">{item.text}</span>
          </>
        )}
      </a>
    </li>
  ))}
</ol>
