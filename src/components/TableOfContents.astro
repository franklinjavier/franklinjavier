---
/**
 * "On this page" table of contents for blog posts, built from the h2/h3
 * headings that `render()` returns plus optional short labels from the
 * post's `toc` frontmatter. Two variants share the list (TocList):
 *
 * - `sidebar`: sticky column on lg+ with its own scroll, a vertical
 *   reading-progress rail and a sliding active indicator on top of it.
 *   Renders the (only) script, which drives every `[data-toc]` nav on the
 *   page, so render it whenever `inline` is.
 * - `inline`: collapsed <details> at the top of the article below lg.
 *
 * Scroll-spy and reading progress share one rAF-throttled scroll handler.
 * Clicks smooth-scroll (instant with prefers-reduced-motion) and push the
 * hash without the native jump.
 * Renders nothing for fewer than two headings (`hasToc()` in lib/toc).
 */
import type { MarkdownHeading } from 'astro'
import TocList from './TocList.astro'
import { ui } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import { hasToc, tocItems, type TocLabels } from '../lib/toc'

interface Props {
  lang: keyof typeof ui
  headings: MarkdownHeading[]
  labels?: TocLabels
  variant: 'sidebar' | 'inline'
}

const { lang, headings, labels, variant } = Astro.props
const t = useTranslations(lang)
const items = tocItems(headings, labels)
const show = hasToc(headings)
const labelId = `toc-label-${variant}`
---

{
  show && variant === 'sidebar' && (
    <nav
      data-toc
      aria-labelledby={labelId}
      class="sticky top-28 flex max-h-[calc(100dvh-9rem)] flex-col text-sm"
    >
      <p
        id={labelId}
        class="mb-4 pl-4 text-xs font-medium tracking-widest text-gray-500 uppercase dark:text-gray-400"
      >
        {t('blog.onThisPage')}
      </p>
      <div data-toc-scroll class="relative min-h-0 overflow-y-auto overscroll-contain pb-1">
        <div data-toc-track class="relative">
          <span
            class="pointer-events-none absolute inset-y-0 left-0 z-10 w-px bg-gray-200 dark:bg-gray-800"
            aria-hidden="true"
          >
            <span class="toc-progress absolute inset-0 origin-top bg-gray-400 dark:bg-gray-500" />
          </span>
          <span
            data-toc-indicator
            class="toc-indicator pointer-events-none absolute top-0 -left-px z-10 w-0.75 rounded-full bg-gray-900 dark:bg-gray-100"
            aria-hidden="true"
          />
          <TocList items={items} variant="rail" />
        </div>
      </div>
    </nav>
  )
}

{
  show && variant === 'inline' && (
    <details class="mb-10 rounded-lg border border-gray-200 text-sm lg:hidden dark:border-gray-800">
      <summary class="cursor-pointer rounded-lg px-4 py-3 text-xs font-medium tracking-widest text-gray-500 uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 dark:text-gray-400 dark:focus-visible:outline-gray-100">
        {t('blog.onThisPage')}
      </summary>
      <nav data-toc aria-label={t('blog.onThisPage')} class="px-1.5 pb-3">
        <TocList items={items} variant="plain" />
      </nav>
    </details>
  )
}

{
  show && variant === 'sidebar' && (
    <script is:inline>
      ;(() => {
        const navs = [...document.querySelectorAll('[data-toc]')]
        const links = navs.flatMap((nav) => [...nav.querySelectorAll('a[href^="#"]')])
        const idOf = (link) => decodeURIComponent(link.hash.slice(1))
        const headings = [...new Set(links.map(idOf))]
          .map((id) => document.getElementById(id))
          .filter(Boolean)
        if (!headings.length) return

        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')
        const root = document.documentElement
        const article = document.querySelector('[data-toc-article]')
        let activeId = null
        let lockedId = null
        let atBottom = false

        // Slide the indicator to the active link and keep that link visible
        // inside the TOC's own scroll box (never scrolls the page).
        const placeIndicator = (nav) => {
          const indicator = nav.querySelector('[data-toc-indicator]')
          const box = nav.querySelector('[data-toc-scroll]')
          if (!indicator || !box) return
          const link = nav.querySelector('a[aria-current]')
          if (!link || !link.offsetParent) {
            indicator.style.opacity = '0'
            return
          }
          const firstPlacement = indicator.style.opacity !== '1'
          if (firstPlacement) indicator.style.transition = 'none'
          indicator.style.opacity = '1'
          indicator.style.transform = `translateY(${link.offsetTop}px)`
          indicator.style.height = `${link.offsetHeight}px`
          if (firstPlacement) {
            indicator.getBoundingClientRect()
            indicator.style.transition = ''
          }
          const top = link.offsetTop
          const bottom = top + link.offsetHeight
          const pad = link.offsetHeight * 2
          if (top - pad < box.scrollTop || bottom + pad > box.scrollTop + box.clientHeight) {
            box.scrollTo({
              top: top - box.clientHeight / 3,
              behavior: firstPlacement || reduceMotion.matches ? 'auto' : 'smooth',
            })
          }
        }

        const setActive = (id) => {
          if (id === activeId) return
          activeId = id
          for (const link of links) {
            if (idOf(link) === id) link.setAttribute('aria-current', 'location')
            else link.removeAttribute('aria-current')
          }
          navs.forEach(placeIndicator)
        }

        // Active = last heading above the line 30% down the viewport (none
        // while reading the intro); at the very bottom, the last heading wins.
        const update = () => {
          if (lockedId) return
          if (atBottom) return setActive(headings[headings.length - 1].id)
          const line = innerHeight * 0.3
          let current = null
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top > line) break
            current = heading
          }
          setActive(current ? current.id : null)
        }

        let ticking = false
        const onScroll = () => {
          if (ticking) return
          ticking = true
          requestAnimationFrame(() => {
            ticking = false
            // Recomputed every frame from live geometry, so slow scrolls in
            // either direction, big jumps and #hash loads all land on the
            // heading above the same 30% line.
            atBottom = innerHeight + scrollY >= root.scrollHeight - 2
            update()
            if (article) {
              const rect = article.getBoundingClientRect()
              const span = rect.height - innerHeight
              const progress = span > 0 ? Math.min(Math.max(-rect.top / span, 0), 1) : 1
              root.style.setProperty('--toc-progress', progress.toFixed(4))
            }
          })
        }
        addEventListener('scroll', onScroll, { passive: true })
        addEventListener(
          'resize',
          () => {
            navs.forEach(placeIndicator)
            onScroll()
          },
          { passive: true },
        )
        // The browser may jump to a #hash (or restore scroll) after this runs.
        addEventListener('load', onScroll)
        addEventListener('hashchange', onScroll)
        onScroll()

        for (const link of links) {
          link.addEventListener('click', (event) => {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
            const target = document.getElementById(idOf(link))
            if (!target) return
            event.preventDefault()
            // Collapse the mobile <details> first so the target doesn't move.
            link.closest('details')?.removeAttribute('open')
            const smooth = !reduceMotion.matches
            setActive(target.id)
            if (smooth) {
              // Hold the indicator on the target while smooth-scrolling past
              // the headings in between.
              lockedId = target.id
              const unlock = () => {
                if (lockedId !== target.id) return
                lockedId = null
                update()
              }
              addEventListener('scrollend', unlock, { once: true })
              setTimeout(unlock, 1000)
            }
            // scroll-margin-top on headings (prose.css) clears the sticky nav.
            target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' })
            history.pushState(null, '', link.hash)
            target.setAttribute('tabindex', '-1')
            target.focus({ preventScroll: true })
          })
        }
      })()
    </script>
  )
}

<style>
  .toc-indicator {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    opacity: 0;
    transition:
      transform 300ms var(--ease-out),
      height 300ms var(--ease-out),
      opacity 150ms ease;
  }

  /* Links render in TocList, outside this component's style scope. */
  :global(.toc-link) {
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  /* Updated every frame from the scroll handler; never animated. */
  .toc-progress {
    transform: scaleY(var(--toc-progress, 0));
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-indicator,
    :global(.toc-link) {
      transition: none;
    }
  }
</style>
