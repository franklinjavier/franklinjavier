---
/**
 * "On this page" table of contents for blog posts, built from the h2/h3
 * headings that `render()` returns plus optional short labels from the
 * post's `toc` frontmatter. Two variants share one list (TocList), which is
 * rendered once, in `inline`; the script clones it into the `sidebar` rail.
 * Without JS the rail stays empty and the <details> also shows on lg+
 * (PostLayout's <noscript> style), so there is always one usable TOC.
 *
 * - `sidebar`: sticky column on lg+ with its own scroll, a vertical
 *   reading-progress rail and a sliding active indicator on top of it.
 *   Compact (short labels) by default; on hover or keyboard focus it expands
 *   over the article as an overlay with the full heading titles, without
 *   changing the rail's width. Escape collapses it until the next hover or
 *   focus move.
 *   Renders the (only) script, which drives every `[data-toc]` nav on the
 *   page, so render it whenever `inline` is.
 * - `inline`: collapsed <details> at the top of the article below lg.
 *
 * Scroll-spy and reading progress share one rAF-throttled scroll handler.
 * Clicks smooth-scroll (instant with prefers-reduced-motion) and push the
 * hash without the native jump.
 * Renders nothing for fewer than two headings (`hasToc()` in lib/toc).
 */
import type { MarkdownHeading } from 'astro'
import TocList from './TocList.astro'
import { ui } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import { hasToc, tocItems, type TocLabels } from '../lib/toc'

interface Props {
  lang: keyof typeof ui
  headings: MarkdownHeading[]
  labels?: TocLabels
  variant: 'sidebar' | 'inline'
}

const { lang, headings, labels, variant } = Astro.props
const t = useTranslations(lang)
const items = tocItems(headings, labels)
const show = hasToc(headings)
const labelId = `toc-label-${variant}`
---

{show && variant === 'sidebar' && (
  <nav data-toc aria-labelledby={labelId} class="sticky top-24 z-20 flow-root text-meta">
    {/* -m-2 p-2 leaves the content where it was and gives the expanded
        overlay its padding without shifting anything. */}
    <div
      data-toc-panel
      class="toc-panel -m-2 flex max-h-[calc(100dvh-7rem)] flex-col rounded-md p-2"
    >
      <p id={labelId} class="mb-2.5 pl-3 text-meta font-[550] text-ink-2">
        {t('blog.onThisPage')}
      </p>
      <div data-toc-scroll class="relative min-h-0 overflow-y-auto overscroll-contain pb-1">
        <div data-toc-track class="relative">
          <span
            class="pointer-events-none absolute inset-y-0 left-0 z-10 w-px bg-rule"
            aria-hidden="true"
          >
            <span class="toc-progress absolute inset-0 origin-top bg-faint" />
          </span>
          <span
            data-toc-indicator
            class="toc-indicator pointer-events-none absolute top-0 -left-px z-10 w-0.75 rounded-full bg-ink"
            aria-hidden="true"
          />
          {/* Filled by the script with a clone of the inline list. */}
          <div data-toc-rail />
        </div>
      </div>
    </div>
  </nav>
)}

{show && variant === 'inline' && (
  <details data-toc-inline class="mb-8 border-y border-rule text-meta lg:hidden">
    <summary class="cursor-pointer py-2.5 text-ink-2 transition-colors duration-200 ease-smooth hover:text-ink">
      {t('blog.onThisPage')}
    </summary>
    <nav data-toc aria-label={t('blog.onThisPage')} class="pb-3">
      <TocList items={items} />
    </nav>
  </details>
)}

{show && variant === 'sidebar' && <script is:inline>
  ;(() => {
    // Same source on every post, so the router does not re-run this script.
    // Listeners are on window/document and would stack. after-swap runs inside
    // the update callback, before the snapshot, so the rail copy is visible
    // during the transition. Abort drops the previous page's listeners.
    let controller = new AbortController()

    const boot = (signal) => {
      // The list ships once (inline <details>); the rail gets a copy without
      // the tooltips, which would only repeat the link text there.
      const source = document.querySelector('[data-toc-inline] ol')
      const rail = document.querySelector('[data-toc-rail]')
      if (source && rail && !rail.firstElementChild) {
        const copy = source.cloneNode(true)
        for (const link of copy.querySelectorAll('a[title]')) link.removeAttribute('title')
        rail.append(copy)
      }

      const navs = [...document.querySelectorAll('[data-toc]')]
      const links = navs.flatMap((nav) => [...nav.querySelectorAll('a[href^="#"]')])
      const idOf = (link) => decodeURIComponent(link.hash.slice(1))
      const headings = [...new Set(links.map(idOf))]
        .map((id) => document.getElementById(id))
        .filter(Boolean)
      if (!headings.length) return

      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')
      const root = document.documentElement
      const article = document.querySelector('[data-toc-article]')
      let activeId = null
      let lockedId = null
      let atBottom = false

      // Slide the indicator to the active link and keep that link visible
      // inside the TOC's own scroll box (never scrolls the page).
      const placeIndicator = (nav, instant = false) => {
        const indicator = nav.querySelector('[data-toc-indicator]')
        const box = nav.querySelector('[data-toc-scroll]')
        if (!indicator || !box) return
        const link = nav.querySelector('a[aria-current]')
        if (!link || !link.offsetParent) {
          indicator.style.opacity = '0'
          return
        }
        const firstPlacement = indicator.style.opacity !== '1'
        const jump = firstPlacement || instant
        if (jump) indicator.style.transition = 'none'
        indicator.style.opacity = '1'
        indicator.style.transform = `translateY(${link.offsetTop}px)`
        indicator.style.height = `${link.offsetHeight}px`
        if (jump) {
          indicator.getBoundingClientRect()
          indicator.style.transition = ''
        }
        const top = link.offsetTop
        const bottom = top + link.offsetHeight
        const pad = link.offsetHeight * 2
        if (top - pad < box.scrollTop || bottom + pad > box.scrollTop + box.clientHeight) {
          box.scrollTo({
            top: top - box.clientHeight / 3,
            behavior: jump || reduceMotion.matches ? 'auto' : 'smooth',
          })
        }
      }

      const setActive = (id) => {
        if (id === activeId) return
        activeId = id
        for (const link of links) {
          if (idOf(link) === id) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        }
        navs.forEach(placeIndicator)
      }

      // Active = last heading above the line 30% down the viewport (none
      // while reading the intro); once scrolled to the very bottom, the last
      // heading wins (a page that fits the viewport never counts as bottom).
      const update = () => {
        if (lockedId) return
        if (atBottom) return setActive(headings[headings.length - 1].id)
        const line = innerHeight * 0.3
        let current = null
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top > line) break
          current = heading
        }
        setActive(current ? current.id : null)
      }

      // Runs on load (including #hash jumps, which fire scroll), every
      // scrolled frame and resize, so big jumps (scrollbar drag, Page Down)
      // are caught too.
      let ticking = false
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          ticking = false
          atBottom = scrollY > 0 && innerHeight + scrollY >= root.scrollHeight - 2
          update()
          if (article) {
            const rect = article.getBoundingClientRect()
            const span = rect.height - innerHeight
            const progress = span > 0 ? Math.min(Math.max(-rect.top / span, 0), 1) : 0
            root.style.setProperty('--toc-progress', progress.toFixed(4))
          }
        })
      }
      addEventListener('scroll', onScroll, { passive: true, signal })
      addEventListener(
        'resize',
        () => {
          navs.forEach(placeIndicator)
          onScroll()
        },
        { passive: true, signal },
      )
      // Images loading above the target move the headings without a scroll.
      addEventListener('load', onScroll, { signal })
      addEventListener('hashchange', onScroll, { signal })
      if (article) {
        const observer = new ResizeObserver(onScroll)
        observer.observe(article)
        signal.addEventListener('abort', () => observer.disconnect())
      }
      onScroll()

      // Sidebar overlay. Expanding/collapsing rewraps the rows, so the
      // indicator follows the track's size. While compact, the nav's height is
      // pinned to the panel's so the sticky nav keeps its size when the panel
      // turns absolute (expanded) and doesn't jump at the end of the article.
      // Escape collapses it via data-toc-collapsed, even with focus inside;
      // the next hover or focus move clears it.
      for (const panel of document.querySelectorAll('[data-toc-panel]')) {
        const nav = panel.closest('[data-toc]')
        const track = panel.querySelector('[data-toc-track]')
        const observer = new ResizeObserver(() => {
          if (getComputedStyle(panel).position === 'static') {
            const { marginTop, marginBottom } = getComputedStyle(panel)
            const height = panel.offsetHeight + parseFloat(marginTop) + parseFloat(marginBottom)
            nav.style.minHeight = `${height}px`
          }
          placeIndicator(nav, true)
        })
        observer.observe(track)
        signal.addEventListener('abort', () => observer.disconnect())
        const reopen = () => panel.removeAttribute('data-toc-collapsed')
        panel.addEventListener('pointerenter', reopen, { signal })
        panel.addEventListener('focusin', reopen, { signal })
        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key !== 'Escape') return
            if (panel.matches(':hover') || panel.contains(document.activeElement)) {
              panel.setAttribute('data-toc-collapsed', '')
            }
          },
          { signal },
        )
      }

      for (const link of links) {
        link.addEventListener(
          'click',
          (event) => {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
            const target = document.getElementById(idOf(link))
            if (!target) return
            event.preventDefault()
            // Collapse the mobile <details> first so the target doesn't move.
            link.closest('details')?.removeAttribute('open')
            const smooth = !reduceMotion.matches
            setActive(target.id)
            if (smooth) {
              // Hold the indicator on the target while smooth-scrolling past
              // the headings in between. Release on scrollend, or (no scrollend
              // support, or nothing to scroll) once scrolling has been idle.
              lockedId = target.id
              let idle = 0
              const settle = () => {
                clearTimeout(idle)
                idle = setTimeout(unlock, 200)
              }
              const unlock = () => {
                clearTimeout(idle)
                removeEventListener('scroll', settle)
                removeEventListener('scrollend', unlock)
                if (lockedId !== target.id) return
                lockedId = null
                update()
              }
              addEventListener('scroll', settle, { passive: true, signal })
              addEventListener('scrollend', unlock, { signal })
              settle()
            }
            // scroll-margin-top on headings (prose.css) clears the sticky nav.
            target.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' })
            // Keep the router's history state. pushState(null) makes Back a no-op
            // for ClientRouter: the URL changes and the page does not.
            history.pushState(history.state, '', link.hash)
            target.setAttribute('tabindex', '-1')
            target.focus({ preventScroll: true })
          },
          { signal },
        )
      }
    }

    const start = () => {
      controller.abort()
      controller = new AbortController()
      boot(controller.signal)
    }

    document.addEventListener('astro:before-swap', () => controller.abort())
    document.addEventListener('astro:after-swap', start)
    start()
  })()
</script>}

<style>
  .toc-indicator {
    opacity: 0;
    transition:
      transform 300ms var(--ease),
      height 300ms var(--ease),
      opacity 150ms var(--ease);
  }

  /* Links render in TocList, outside this component's style scope. */
  :global(.toc-link) {
    transition: color 150ms var(--ease);
  }

  /* Rail copy: clear the progress line on the left, round the right side only. */
  [data-toc-rail] :global(.toc-link) {
    padding-left: 0.75rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  [data-toc-rail] :global(.toc-link[data-depth='3']) {
    padding-left: 2.25rem;
  }

  /* Updated every frame from the scroll handler; never animated. */
  .toc-progress {
    transform: scaleY(var(--toc-progress, 0));
  }

  /*
   * Expanded overlay: hover (pointer devices only) or keyboard focus, unless
   * Escape set data-toc-collapsed. Absolute against the sticky nav, so the
   * rail keeps its width and nothing reflows; the negative margin keeps the
   * content in place. Its max-height and inner scroll box carry over.
   */
  @media (hover: hover) {
    .toc-panel:hover:not([data-toc-collapsed]) {
      position: absolute;
      top: 0;
      left: 0;
      width: max-content;
      min-width: calc(100% + 1rem);
      max-width: 21rem;
      background-color: var(--bg);
      box-shadow: 0 0 0 1px var(--rule);
      animation: toc-reveal 180ms var(--ease);
    }

    /* Visually hidden, not display: none, so the link name keeps the label. */
    .toc-panel:hover:not([data-toc-collapsed]) :global(.toc-short) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .toc-panel:hover:not([data-toc-collapsed]) :global(.toc-full) {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      text-wrap: pretty;
    }
  }

  .toc-panel:has(:focus-visible):not([data-toc-collapsed]) {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    min-width: calc(100% + 1rem);
    max-width: 21rem;
    background-color: var(--bg);
    box-shadow: 0 0 0 1px var(--rule);
    animation: toc-reveal 180ms var(--ease);
  }

  .toc-panel:has(:focus-visible):not([data-toc-collapsed]) :global(.toc-short) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .toc-panel:has(:focus-visible):not([data-toc-collapsed]) :global(.toc-full) {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    text-wrap: pretty;
  }

  /* Opens rightward from the rail's own width. */
  @keyframes toc-reveal {
    from {
      clip-path: inset(-1px calc(100% - var(--rail) - 1rem) -1px -1px);
    }
    to {
      clip-path: inset(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-indicator,
    .toc-panel,
    :global(.toc-link) {
      transition: none;
      animation: none !important;
    }
  }
</style>
