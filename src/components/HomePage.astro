---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import { useTranslations, formatDate, getPostUrl } from '../i18n/utils'
import { DEV_STACK } from '../lib/site'

interface Props {
  lang: 'pt-br' | 'en'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="Principal Engineer" lang={lang}>
  <Navigation />

  <main class="pt-32 pb-20">
    <!-- Hero Section -->
    <section class="mx-auto mb-24 max-w-7xl px-8" id="about">
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
        <div>
          <h1 class="mb-6 text-4xl leading-tight font-bold lg:text-5xl">{t('hero.title')}</h1>
          <div class="max-w-xl space-y-5 text-base text-gray-700 dark:text-gray-300">
            <p>{t('hero.bio1')}</p>
            <p>{t('hero.bio2')}</p>
            <p>{t('hero.bio3')}</p>
          </div>
        </div>

        <!-- Photo -->
        <div class="relative mx-auto w-full max-w-md">
          <div class="hero-photo shadow-2xl">
            <img
              src="/img/frank.jpeg"
              alt="Franklin Javier"
              class="h-auto w-full rounded-3xl"
              width="600"
              height="600"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Info Section -->
    <section class="mx-auto max-w-7xl px-8">
      <div class="grid grid-cols-1 gap-16 md:grid-cols-3">
        <div>
          <h2 class="mb-6 text-lg font-bold">{t('experience.title')}</h2>
          <div class="space-y-6 text-sm">
            <div>
              <p class="text-gray-700 dark:text-gray-300">{t('experience.role1')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.company1')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.period1')}</p>
            </div>
            <div>
              <p class="text-gray-700 dark:text-gray-300">{t('experience.role2')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.company2')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.period2')}</p>
            </div>
            <div>
              <p class="text-gray-700 dark:text-gray-300">{t('experience.role3')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.company3')}</p>
              <p class="text-gray-500 dark:text-gray-400">{t('experience.period3')}</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="mb-6 text-lg font-bold">{t('stack.title')}</h2>
          <div class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
            {DEV_STACK.map((item) => <p>{item}</p>)}
          </div>
        </div>

        <div>
          <h2 class="mb-6 text-lg font-bold">{t('contact.title')}</h2>
          <div class="space-y-2 text-sm">
            <p class="text-gray-700 dark:text-gray-300">{t('contact.location')}</p>
            <a
              href="mailto:franklinjalves@gmail.com"
              class="block text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100"
            >
              franklinjalves@gmail.com
            </a>
            <a
              href="https://www.linkedin.com/in/franklin-javier-98504321"
              target="_blank"
              rel="noopener"
              class="block text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100"
            >
              LinkedIn
            </a>
            <a
              href="https://x.com/franklinjavier"
              target="_blank"
              rel="noopener"
              class="block text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100"
            >
              X
            </a>
            <a
              href="/cv.pdf"
              target="_blank"
              class="block text-gray-700 underline hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100"
            >
              {t('contact.downloadCV')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Posts Section -->
    <section class="mx-auto mt-32 max-w-7xl px-8" id="posts">
      <h2 class="mb-12 text-3xl font-bold">{t('blog.recentPosts')}</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          sortedPosts.slice(0, 6).map((post) => {
            const formattedDate = formatDate(post.data.date, lang)
            const postUrl = getPostUrl(post.id, lang)

            return (
              <article class="group">
                <a href={postUrl} class="block">
                  <h3 class="mb-2 text-xl font-semibold group-hover:underline">
                    {post.data.title}
                  </h3>
                  <time class="text-sm text-gray-500 dark:text-gray-400">{formattedDate}</time>
                  {post.data.description && (
                    <p class="mt-3 text-gray-700 dark:text-gray-300">{post.data.description}</p>
                  )}
                </a>
              </article>
            )
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero photo: settles into its tilt on load, straightens a little on hover.
     Opacity stays at 1 so the photo (the page's LCP) paints on the first frame. */
  .hero-photo {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    rotate: 3deg;
    transition:
      rotate 250ms var(--ease-out),
      scale 250ms var(--ease-out);
    /* backwards (not both): once it ends, the hover transition takes over. */
    animation: hero-photo-in 700ms var(--ease-out) 100ms backwards;
  }

  @keyframes hero-photo-in {
    from {
      rotate: -3deg;
      scale: 0.94;
      translate: 0 1.5rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-photo:hover {
      rotate: 0deg;
      scale: 1.02;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
      transition: none;
    }
  }
</style>
