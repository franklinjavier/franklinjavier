---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import { useTranslations, formatDate, getPostUrl } from '../i18n/utils'
import { DEV_STACK } from '../lib/site'
import {
  page,
  hero,
  heroGrid,
  heroTitle,
  heroBio,
  photoWrap,
  photoFrame,
  photo,
  info,
  infoGrid,
  infoTitle,
  stack6,
  stack2,
  stack2Muted,
  textPrimary,
  textMuted,
  contactLink,
  posts,
  postsTitle,
  postsGrid,
  cardGroup,
  block,
  cardTitle,
  mutedTime,
  cardDescription,
} from './HomePage.stylex'

interface Props {
  lang: 'pt-br' | 'en'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="Principal Engineer" lang={lang}>
  <Navigation />

  <main class={page.class}>
    <section class={hero.class} id="about">
      <div class={heroGrid.class}>
        <div>
          <h1 class={heroTitle.class} set:html={t('hero.title').replace('\n', '<br />')} />
          <div class={heroBio.class}>
            <p>{t('hero.bio1')}</p>
            <p>{t('hero.bio2')}</p>
            <p>{t('hero.bio3')}</p>
          </div>
        </div>

        <div class={photoWrap.class}>
          <div class={photoFrame.class}>
            <img
              src="/img/frank.jpeg"
              alt="Franklin Javier"
              class={photo.class}
              width="600"
              height="600"
            />
          </div>
        </div>
      </div>
    </section>

    <section class={info.class}>
      <div class={infoGrid.class}>
        <div>
          <h2 class={infoTitle.class}>{t('experience.title')}</h2>
          <div class={stack6.class}>
            <div>
              <p class={textPrimary.class}>{t('experience.role1')}</p>
              <p class={textMuted.class}>{t('experience.company1')}</p>
              <p class={textMuted.class}>{t('experience.period1')}</p>
            </div>
            <div>
              <p class={textPrimary.class}>{t('experience.role2')}</p>
              <p class={textMuted.class}>{t('experience.company2')}</p>
              <p class={textMuted.class}>{t('experience.period2')}</p>
            </div>
            <div>
              <p class={textPrimary.class}>{t('experience.role3')}</p>
              <p class={textMuted.class}>{t('experience.company3')}</p>
              <p class={textMuted.class}>{t('experience.period3')}</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class={infoTitle.class}>{t('stack.title')}</h2>
          <div class={stack2Muted.class}>
            {DEV_STACK.map((item) => <p>{item}</p>)}
          </div>
        </div>

        <div>
          <h2 class={infoTitle.class}>{t('contact.title')}</h2>
          <div class={stack2.class}>
            <p class={textPrimary.class}>{t('contact.location')}</p>
            <a href="mailto:franklinjalves@gmail.com" class={contactLink.class}>
              franklinjalves@gmail.com
            </a>
            <a
              href="https://www.linkedin.com/in/franklin-javier-98504321"
              target="_blank"
              rel="noopener"
              class={contactLink.class}
            >
              LinkedIn
            </a>
            <a
              href="https://x.com/franklinjavier"
              target="_blank"
              rel="noopener"
              class={contactLink.class}
            >
              X
            </a>
            <a href="/cv.pdf" target="_blank" class={contactLink.class}>
              {t('contact.downloadCV')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class={posts.class} id="posts">
      <h2 class={postsTitle.class}>{t('blog.recentPosts')}</h2>
      <div class={postsGrid.class}>
        {
          sortedPosts.slice(0, 6).map((post) => {
            const formattedDate = formatDate(post.data.date, lang)
            const postUrl = getPostUrl(post.id, lang)

            return (
              <article class={cardGroup.class}>
                <a href={postUrl} class={block.class}>
                  <h3 class={cardTitle.class}>{post.data.title}</h3>
                  <time class={mutedTime.class}>{formattedDate}</time>
                  {post.data.description && (
                    <p class={cardDescription.class}>{post.data.description}</p>
                  )}
                </a>
              </article>
            )
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>
