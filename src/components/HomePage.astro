---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from '../components/Navigation.astro'
import {
  useTranslations,
  formatDate,
  getPostUrl,
  getLocalizedPath,
  getAlternateUrl,
} from '../i18n/utils'
import { stars, formatStars, orderOpenSource } from '../lib/oss'
import { DEV_STACK, SIDE_PROJECTS } from '../lib/site'

interface Props {
  lang: 'pt-br' | 'en'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout
  title={t('home.title')}
  description={t('home.description')}
  lang={lang}
  alternate={getAlternateUrl(Astro.url, lang === 'en' ? 'pt-br' : 'en')}
  markdownTwin
>
  <Navigation />

  <main class="site-container pt-20 pb-24">
    <!-- Hero Section -->
    <section class="mb-20" id="about">
      <div class="grid grid-cols-1 items-center gap-10 sm:grid-cols-[minmax(0,1fr)_11rem]">
        <div>
          <h1 class="mb-4 text-[1.375rem] leading-tight font-[550] text-ink">{t('hero.title')}</h1>
          <div class="space-y-3 text-ink-2">
            <p>{t('hero.bio1')}</p>
          </div>
        </div>

        <!-- Photo -->
        <div class="relative mx-auto w-full max-w-44">
          <div class="hero-photo">
            <img
              src="/img/frank.jpeg"
              alt="Franklin Javier"
              class="h-auto w-full rounded-2xl shadow-[0_0_0_1px_rgb(0_0_0_/_0.04)]"
              width="600"
              height="600"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Info Section -->
    <section class="border-t border-rule pt-8">
      <div class="grid grid-cols-1 gap-10 text-[0.8125rem] leading-5 sm:grid-cols-2 sm:gap-8">
        <div>
          <h2 class="mb-3 font-[550] text-ink">{t('stack.title')}</h2>
          <div class="space-y-1 text-ink-2">
            {DEV_STACK.map((item) => (
              <p>{item}</p>
            ))}
          </div>
        </div>

        <div>
          <h2 class="mb-3 font-[550] text-ink">{t('contact.title')}</h2>
          <div class="space-y-1">
            <p class="text-ink-2">{t('contact.location')}</p>
            <a
              href="mailto:franklinjalves@gmail.com"
              class="block w-fit text-ink-2 underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-current"
            >
              franklinjalves@gmail.com
            </a>
            <a
              href="https://www.linkedin.com/in/franklin-javier-98504321"
              target="_blank"
              rel="noopener"
              class="block w-fit text-ink-2 underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-current"
            >
              LinkedIn
            </a>
            <a
              href="https://x.com/franklinjavier"
              target="_blank"
              rel="noopener"
              class="block w-fit text-ink-2 underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-current"
            >
              X
            </a>
            <a
              href={getLocalizedPath('/cv/', lang)}
              class="block w-fit text-ink-2 underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-current"
            >
              {t('nav.cv')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Posts Section -->
    <section class="mt-20" id="posts">
      <h2 class="mb-4 font-[550] text-ink">{t('blog.recentPosts')}</h2>
      <ul class="border-t border-rule">
        {sortedPosts.slice(0, 6).map((post) => {
          const formattedDate = formatDate(post.data.date, lang)
          const postUrl = getPostUrl(post.id, lang)

          return (
            <li class="border-b border-rule">
              <a href={postUrl} class="group block py-3">
                <div class="flex flex-col gap-x-6 gap-y-0.5 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="font-[550] text-ink decoration-muted underline-offset-3 group-hover:underline">
                    {post.data.title}
                  </h3>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="shrink-0 text-meta text-muted tabular-nums"
                  >
                    {formattedDate}
                  </time>
                </div>
                {post.data.description && (
                  <p class="mt-1 text-[0.8125rem] leading-5 text-ink-2">{post.data.description}</p>
                )}
              </a>
            </li>
          )
        })}
      </ul>
    </section>

    <!-- Side Projects Section -->
    <section class="mt-20" id="projects">
      <h2 class="mb-4 font-[550] text-ink">{t('projects.title')}</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {SIDE_PROJECTS.map((project) => (
          <article class="group">
            <a href={project.url} target="_blank" rel="noopener" class="flex gap-4 sm:block">
              <img
                src={project.image}
                alt=""
                width="800"
                height="420"
                loading="lazy"
                decoding="async"
                class="aspect-[40/21] w-32 shrink-0 rounded-md object-cover shadow-[0_0_0_1px_rgb(0_0_0_/_0.04)] sm:mb-3 sm:w-full dark:shadow-[0_0_0_1px_rgb(255_255_255_/_0.05)]"
              />
              <div>
                <h3 class="mb-1 font-[550] text-ink decoration-muted underline-offset-3 group-hover:underline">
                  {project.name}
                </h3>
                <p class="text-[0.8125rem] leading-5 text-muted">{t(`projects.${project.key}`)}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="mt-20" id="open-source">
      <h2 class="mb-4 font-[550] text-ink">{t('oss.title')}</h2>
      <ul class="border-t border-rule">
        {orderOpenSource(stars).map((repo) => (
          <li class="border-b border-rule py-3">
            <h3 class="font-[550] text-ink">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener"
                class="break-words decoration-muted underline-offset-3 hover:underline"
              >
                {repo.name}
              </a>
            </h3>
            <p class="mt-1 text-[0.8125rem] leading-5 text-muted">{t(`oss.${repo.key}`)}</p>
            <div class="mt-1 flex gap-3 text-meta text-muted">
              {repo.language && <span>{repo.language}</span>}
              {stars[repo.name] !== undefined && (
                <span aria-label={`${formatStars(stars[repo.name])} ${t('oss.stars')}`}>
                  ★ {formatStars(stars[repo.name])}
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero photo: settles into its tilt on load, straightens a little on hover.
     Opacity stays at 1 so the photo (the page's LCP) paints on the first frame. */
  .hero-photo {
    --ease-out: var(--ease);
    rotate: 3deg;
    transition:
      rotate 250ms var(--ease-out),
      scale 250ms var(--ease-out);
    /* backwards (not both): once it ends, the hover transition takes over. */
    animation: hero-photo-in 700ms var(--ease-out) 100ms backwards;
  }

  @keyframes hero-photo-in {
    from {
      rotate: -3deg;
      scale: 0.94;
      translate: 0 1.5rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-photo:hover {
      rotate: 0deg;
      scale: 1.02;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
      transition: none;
    }
  }
</style>
