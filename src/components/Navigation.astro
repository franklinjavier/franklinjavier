---
import ThemeToggle from './ThemeToggle.astro'
import LanguageToggle from './LanguageToggle.astro'
import { useTranslations, getLangFromUrl } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const homeUrl = lang === 'en' ? '/' : '/pt-br/'
const aboutUrl = lang === 'en' ? '/about/' : '/pt-br/about/'
const postsUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const items = [
  { href: homeUrl, label: t('nav.home') },
  { href: postsUrl, label: t('nav.blog') },
  { href: aboutUrl, label: t('nav.about') },
].map((item) => ({
  ...item,
  // Exact match is the page; anything under /blog/ is still the Blog section.
  current:
    path === item.href
      ? ('page' as const)
      : item.href !== homeUrl && path.startsWith(item.href)
        ? ('true' as const)
        : undefined,
}))

const control =
  'inline-flex h-11 min-w-11 items-center justify-center transition-colors duration-200 ease-smooth hover:text-ink motion-reduce:transition-none sm:h-8 sm:min-w-8'
---

<header class="sticky top-0 z-50 border-b border-rule bg-page site-header">
  {/* Same container as every page body (site-container, global.css). */}
  <div class="site-container">
    <div class="flex h-12 items-center justify-between gap-4 text-[0.8125rem] leading-none">
      <nav aria-label={t('nav.label')}>
        <ul class="flex items-center gap-x-5 sm:gap-x-6">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current}
                class:list={[control, 'text-muted [&[aria-current]]:text-ink']}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="-mr-2 flex items-center gap-1">
        <LanguageToggle class={control} />
        <ThemeToggle class={control} />
      </div>
    </div>
  </div>
</header>
