---
import ThemeToggle from './ThemeToggle.astro'
import LanguageToggle from './LanguageToggle.astro'
import { useTranslations, getLangFromUrl } from '../i18n/utils'
import { nav, inner, row, link, actions } from './Navigation.stylex'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const homeUrl = lang === 'en' ? '/' : '/pt-br/'
const aboutUrl = lang === 'en' ? '/#about' : '/pt-br/#about'
const postsUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'
const speakingUrl = lang === 'en' ? '/speaking/' : '/pt-br/speaking/'
---

<nav class={nav.class}>
  <div class={inner.class}>
    <div class={row.class}>
      <a href={homeUrl} class={link.class}>{t('nav.home')}</a>
      <a href={postsUrl} class={link.class}>{t('nav.blog')}</a>
      <a href={speakingUrl} class={link.class}>{t('nav.speaking')}</a>
      <a href={aboutUrl} class={link.class}>{t('nav.about')}</a>
      <div class={actions.class}>
        <LanguageToggle />
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>
