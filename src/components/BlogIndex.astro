---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, parseTags, getTagUrl, getPostUrl } from '../i18n/utils'

interface Props {
  lang: 'en' | 'pt-br'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const title = t('blog.title')
const description = t('blog.description')

// Built here rather than interpolated across JSX lines: a line break between
// sibling expressions collapses the space between them.
const countLabel = `${allPosts.length} ${
  allPosts.length === 1 ? t('blog.articleCount') : t('blog.articlesCount')
}`
const summary = `${countLabel} - ${description}`
---

<BaseLayout title={title} description={description} lang={lang}>
  <Navigation />

  <main class="pt-32 pb-20">
    <div class="mx-auto max-w-4xl px-8">
      <!-- Header -->
      <header class="mb-16">
        <h1 class="mb-4 text-5xl font-bold">{t('blog.title')}</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">{summary}</p>
      </header>

      <!-- Posts list -->
      <div class="space-y-12">
        {
          sortedPosts.map((post) => {
            const formattedDate = formatDate(post.data.date, lang)
            const postUrl = getPostUrl(post.id, lang)
            const tags = parseTags(post.data.tags)

            return (
              <article class="group border-b border-gray-200 pb-12 last:border-0 dark:border-gray-800">
                <div>
                  <a href={postUrl} class="block">
                    <time class="text-sm text-gray-500 dark:text-gray-400">{formattedDate}</time>
                    <h2 class="mt-2 mb-3 text-2xl font-bold group-hover:underline">
                      {post.data.title}
                    </h2>
                    {post.data.description && (
                      <p class="leading-relaxed text-gray-700 dark:text-gray-300">
                        {post.data.description}
                      </p>
                    )}
                  </a>
                  {tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {tags.map((tag) => {
                        return (
                          <a
                            href={getTagUrl(tag, lang)}
                            class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600 transition hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
                          >
                            {tag}
                          </a>
                        )
                      })}
                    </div>
                  )}
                  <a
                    href={postUrl}
                    class="mt-4 block text-sm text-gray-600 transition hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
                  >
                    {t('blog.readMore')}
                  </a>
                </div>
              </article>
            )
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>
