---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, parseTags, getTagUrl, getPostUrl } from '../i18n/utils'
import {
  page,
  container,
  header,
  title as heading,
  lead,
  list,
  article,
  block,
  time,
  articleTitle,
  description as excerpt,
  tagRow,
  tag,
  readMore,
} from './BlogIndex.stylex'

interface Props {
  lang: 'en' | 'pt-br'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const title = t('blog.title')
const description = t('blog.description')

// Built here rather than interpolated across JSX lines: a line break between
// sibling expressions collapses the space between them.
const countLabel = `${allPosts.length} ${
  allPosts.length === 1 ? t('blog.articleCount') : t('blog.articlesCount')
}`
const summary = `${countLabel} - ${description}`
---

<BaseLayout title={title} description={description} lang={lang}>
  <Navigation />

  <main class={page.class}>
    <div class={container.class}>
      <!-- Header -->
      <header class={header.class}>
        <h1 class={heading.class}>{t('blog.title')}</h1>
        <p class={lead.class}>{summary}</p>
      </header>

      <!-- Posts list -->
      <div class={list.class}>
        {
          sortedPosts.map((post) => {
            const formattedDate = formatDate(post.data.date, lang)
            const postUrl = getPostUrl(post.id, lang)
            const tags = parseTags(post.data.tags)

            return (
              <article class={article.class}>
                <div>
                  <a href={postUrl} class={block.class}>
                    <time class={time.class}>{formattedDate}</time>
                    <h2 class={articleTitle.class}>{post.data.title}</h2>
                    {post.data.description && (
                      <p class={excerpt.class}>{post.data.description}</p>
                    )}
                  </a>
                  {tags.length > 0 && (
                    <div class={tagRow.class}>
                      {tags.map((item) => {
                        return (
                          <a href={getTagUrl(item, lang)} class={tag.class}>
                            {item}
                          </a>
                        )
                      })}
                    </div>
                  )}
                  <a href={postUrl} class={readMore.class}>
                    {t('blog.readMore')}
                  </a>
                </div>
              </article>
            )
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>
