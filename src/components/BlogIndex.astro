---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import {
  useTranslations,
  formatDate,
  parseTags,
  getTagUrl,
  getPostUrl,
  getAlternateUrl,
} from '../i18n/utils'
import { viewTransitionName } from '../lib/view-transition'

interface Props {
  lang: 'en' | 'pt-br'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true && data.lang === lang
})

const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const title = t('blog.title')
const description = t('blog.description')

// Built here rather than interpolated across JSX lines: a line break between
// sibling expressions collapses the space between them.
const countLabel = `${allPosts.length} ${
  allPosts.length === 1 ? t('blog.articleCount') : t('blog.articlesCount')
}`
const summary = `${countLabel} - ${description}`
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  alternate={getAlternateUrl(Astro.url, lang === 'en' ? 'pt-br' : 'en')}
  markdownTwin
>
  <Navigation />

  <main class="site-container pt-20 pb-24">
    <!-- Header -->
    <header class="mb-8">
      <h1 class="mb-2 text-[1.375rem] leading-tight font-[550] text-ink">{t('blog.title')}</h1>
      <p class="text-[0.8125rem] leading-5 text-muted">{summary}</p>
    </header>

    <!-- Posts list -->
    <div class="border-t border-rule">
      {sortedPosts.map((post) => {
        const formattedDate = formatDate(post.data.date, lang)
        const postUrl = getPostUrl(post.id, lang)
        const tags = parseTags(post.data.tags)

        return (
          <article class="group border-b border-rule py-5">
            <a href={postUrl} class="block">
              <time
                datetime={post.data.date.toISOString()}
                class="text-meta text-muted tabular-nums"
                style={`view-transition-name: ${viewTransitionName('date', post.id)}`}
              >
                {formattedDate}
              </time>
              <h2
                class="mt-0.5 font-[550] text-ink decoration-muted underline-offset-3 group-hover:underline"
                style={`view-transition-name: ${viewTransitionName('title', post.id)}`}
              >
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="mt-1 text-[0.8125rem] leading-5 text-ink-2">{post.data.description}</p>
              )}
            </a>
            <p class="mt-2 flex flex-wrap items-baseline gap-x-1.5 text-meta text-muted">
              {tags.length > 0 && (
                <>
                  <span>
                    {tags.map((tag, index) => (
                      <>
                        {index > 0 && ', '}
                        <a
                          href={getTagUrl(tag, lang)}
                          class="underline decoration-dotted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-solid"
                        >
                          {tag}
                        </a>
                      </>
                    ))}
                  </span>
                  <span aria-hidden="true">·</span>
                </>
              )}
              <a
                href={postUrl}
                class="underline decoration-dotted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-solid"
              >
                {t('blog.readMore')}
              </a>
            </p>
          </article>
        )
      })}
    </div>
  </main>
</BaseLayout>
