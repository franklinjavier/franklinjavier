---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, getLocalizedPath } from '../i18n/utils'
import { APPEARANCES, speakingJsonLd } from '../lib/speaking'
import {
  page,
  container,
  header,
  title,
  intro,
  list,
  article,
  meta,
  kind,
  talkTitle,
  talkLink,
  summary,
  withLine,
  action,
  invite,
  inviteLink,
} from './Speaking.stylex'

interface Props {
  lang: 'en' | 'pt-br'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const appearances = [...APPEARANCES].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
---

<BaseLayout
  title={t('speaking.title')}
  description={t('speaking.description')}
  lang={lang}
  jsonLd={speakingJsonLd(lang)}
>
  <Navigation />

  <main class={page.class}>
    <div class={container.class}>
      <header class={header.class}>
        <h1 class={title.class}>{t('speaking.title')}</h1>
        <p class={intro.class}>{t('speaking.intro')}</p>
      </header>

      <div class={list.class}>
        {
          appearances.map((appearance) => {
            const kindLabel =
              appearance.kind === 'podcast' ? t('speaking.kind.podcast') : t('speaking.kind.talk')
            const actionLabel =
              appearance.kind === 'podcast'
                ? t('speaking.action.podcast')
                : t('speaking.action.talk')

            return (
              <article class={article.class}>
                <div class={meta.class}>
                  <span class={kind.class}>{kindLabel}</span>
                  <span>{appearance.event}</span>
                  {appearance.date && (
                    <time datetime={appearance.date}>
                      {formatDate(new Date(`${appearance.date}T00:00:00Z`), lang)}
                    </time>
                  )}
                </div>

                <h2 class={talkTitle.class}>
                  <a href={appearance.url} target="_blank" rel="noopener" class={talkLink.class}>
                    {appearance.title[lang]}
                  </a>
                </h2>

                <p class={summary.class}>{appearance.summary[lang]}</p>

                {appearance.with && appearance.with.length > 0 && (
                  <p class={withLine.class}>
                    {t('speaking.with')}: {appearance.with.join(', ')}
                  </p>
                )}

                <a href={appearance.url} target="_blank" rel="noopener" class={action.class}>
                  {actionLabel} →
                </a>
              </article>
            )
          })
        }
      </div>

      <p class={invite.class}>
        <a href={getLocalizedPath('/contact/', lang)} class={inviteLink.class}>
          {t('speaking.invite')}
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
