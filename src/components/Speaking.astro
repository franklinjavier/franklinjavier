---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navigation from './Navigation.astro'
import { useTranslations, formatDate, getLocalizedPath, getAlternateUrl } from '../i18n/utils'
import { APPEARANCES, speakingJsonLd } from '../lib/speaking'

interface Props {
  lang: 'en' | 'pt-br'
}

const { lang } = Astro.props
const t = useTranslations(lang)

const appearances = [...APPEARANCES].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
---

<BaseLayout
  title={t('speaking.title')}
  description={t('speaking.description')}
  lang={lang}
  jsonLd={speakingJsonLd(lang)}
  alternate={getAlternateUrl(Astro.url, lang === 'en' ? 'pt-br' : 'en')}
  markdownTwin
>
  <Navigation />

  <main class="pt-20 pb-24">
    <div class="site-container">
      <header class="mb-8">
        <h1 class="mb-2 text-[1.375rem] leading-tight font-[550] text-ink">
          {t('speaking.title')}
        </h1>
        <p class="text-[0.8125rem] leading-5 text-muted">{t('speaking.intro')}</p>
      </header>

      <div class="border-t border-rule">
        {appearances.map((appearance) => {
          const kindLabel =
            appearance.kind === 'podcast' ? t('speaking.kind.podcast') : t('speaking.kind.talk')
          const actionLabel =
            appearance.kind === 'podcast' ? t('speaking.action.podcast') : t('speaking.action.talk')

          return (
            <article class="group border-b border-rule py-5">
              <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-meta text-muted">
                <span>{kindLabel}</span>
                <span aria-hidden="true">·</span>
                <span>{appearance.event}</span>
                {appearance.date && <span aria-hidden="true">·</span>}
                {appearance.date && (
                  <time datetime={appearance.date}>
                    {formatDate(new Date(`${appearance.date}T00:00:00Z`), lang)}
                  </time>
                )}
              </div>

              <h2 class="mt-0.5 mb-1 font-[550] text-ink">
                <a
                  href={appearance.url}
                  target="_blank"
                  rel="noopener"
                  class="decoration-muted underline-offset-3 group-hover:underline"
                >
                  {appearance.title[lang]}
                </a>
              </h2>

              <p class="text-[0.8125rem] leading-5 text-ink-2">{appearance.summary[lang]}</p>

              {appearance.with && appearance.with.length > 0 && (
                <p class="mt-2 text-meta text-muted">
                  {t('speaking.with')}: {appearance.with.join(', ')}
                </p>
              )}

              <a
                href={appearance.url}
                target="_blank"
                rel="noopener"
                class="mt-2 block w-fit text-meta text-muted underline decoration-dotted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink hover:decoration-solid"
              >
                {actionLabel} →
              </a>
            </article>
          )
        })}
      </div>

      <p class="mt-10 text-[0.8125rem] text-muted">
        <a
          href={getLocalizedPath('/contact/', lang)}
          class="underline decoration-muted underline-offset-3 transition-colors duration-200 ease-smooth hover:text-ink"
        >
          {t('speaking.invite')}
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
