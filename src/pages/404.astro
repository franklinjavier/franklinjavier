---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const homeUrl = lang === 'en' ? '/' : '/pt-br/'
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'

const helpLinks = [
  { href: homeUrl, label: t('404.goHome') },
  { href: blogUrl, label: t('nav.blog') },
  { href: '/sitemap.xml', label: t('404.sitemap') },
  { href: '/llms.txt', label: t('404.llms') },
]
---

<BaseLayout title={t('404.title')} lang={lang}>
  <main class="flex min-h-screen items-center justify-center px-8">
    <div class="text-center">
      <h1 class="glitch text-9xl font-bold text-ink" data-text="404">
        404
      </h1>

      <p class="mt-8 text-lg text-ink-2">{t('404.message')}</p>

      <p class="mt-8 text-sm text-muted">{t('404.help')}</p>

      <ul class="mt-4 space-y-2 text-sm">
        {helpLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-ink-2 underline decoration-muted underline-offset-3 hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <style>
    @keyframes glitch {
      0% {
        text-shadow:
          0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      14% {
        text-shadow:
          0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      15% {
        text-shadow:
          -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      49% {
        text-shadow:
          -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      50% {
        text-shadow:
          0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      99% {
        text-shadow:
          0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      100% {
        text-shadow:
          -0.025em 0 0 rgba(255, 0, 0, 0.75),
          -0.025em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
    }

    /* Four runs, then it stops on its own (WCAG 2.2.2: under 5 seconds). */
    .glitch {
      animation: glitch 1s linear 4;
    }

    @media (prefers-reduced-motion: reduce) {
      .glitch {
        animation: none;
      }
    }
  </style>
</BaseLayout>
