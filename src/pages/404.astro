---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const homeUrl = lang === 'en' ? '/' : '/pt-br/'
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'

const helpLinks = [
  { href: homeUrl, label: t('404.goHome') },
  { href: blogUrl, label: t('nav.blog') },
  { href: '/sitemap.xml', label: t('404.sitemap') },
  { href: '/llms.txt', label: t('404.llms') },
]
---

<BaseLayout title={t('404.title')} lang={lang}>
  <main class="min-h-screen flex items-center justify-center px-8">
    <div class="text-center">
      <h1 class="text-9xl font-bold text-gray-900 dark:text-gray-100 glitch" data-text="404">
        404
      </h1>

      <p class="text-xl text-gray-600 dark:text-gray-400 mt-8">
        {t('404.message')}
      </p>

      <p class="text-sm text-gray-500 dark:text-gray-400 mt-8">
        {t('404.help')}
      </p>

      <ul class="mt-4 space-y-2 text-sm">
        {
          helpLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <style>
    @keyframes glitch {
      0% {
        text-shadow: 0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      14% {
        text-shadow: 0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      15% {
        text-shadow: -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      49% {
        text-shadow: -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      50% {
        text-shadow: 0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      99% {
        text-shadow: 0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      100% {
        text-shadow: -0.025em 0 0 rgba(255, 0, 0, 0.75),
          -0.025em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
    }

    .glitch {
      animation: glitch 1s linear infinite;
    }
  </style>
</BaseLayout>
