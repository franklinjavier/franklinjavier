---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { main, center, code, message, help, list, link } from './_404.stylex'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const homeUrl = lang === 'en' ? '/' : '/pt-br/'
const blogUrl = lang === 'en' ? '/blog/' : '/pt-br/blog/'

const helpLinks = [
  { href: homeUrl, label: t('404.goHome') },
  { href: blogUrl, label: t('nav.blog') },
  { href: '/sitemap.xml', label: t('404.sitemap') },
  { href: '/llms.txt', label: t('404.llms') },
]
---

<BaseLayout title={t('404.title')} lang={lang}>
  <main class={main.class}>
    <div class={center.class}>
      <h1 class:list={['glitch', code.class]} data-text="404">404</h1>

      <p class={message.class}>{t('404.message')}</p>

      <p class={help.class}>{t('404.help')}</p>

      <ul class={list.class}>
        {
          helpLinks.map((item) => (
            <li>
              <a href={item.href} class={link.class}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <style>
    @keyframes glitch {
      0% {
        text-shadow:
          0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      14% {
        text-shadow:
          0.05em 0 0 rgba(255, 0, 0, 0.75),
          -0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
      }
      15% {
        text-shadow:
          -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      49% {
        text-shadow:
          -0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
          0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
          -0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      50% {
        text-shadow:
          0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      99% {
        text-shadow:
          0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
          0.05em 0 0 rgba(0, 255, 0, 0.75),
          0 -0.05em 0 rgba(0, 0, 255, 0.75);
      }
      100% {
        text-shadow:
          -0.025em 0 0 rgba(255, 0, 0, 0.75),
          -0.025em -0.025em 0 rgba(0, 255, 0, 0.75),
          -0.025em -0.05em 0 rgba(0, 0, 255, 0.75);
      }
    }

    .glitch {
      animation: glitch 1s linear infinite;
    }
  </style>
</BaseLayout>
