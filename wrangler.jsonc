{
  "name": "blog",
  "main": "worker.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // franklinjavier.com is a Workers Custom Domain on the production `blog` Worker
  // (attached 2026-10-21). Declared here so `wrangler deploy` keeps it. Top-level
  // `routes` IS inheritable, so env.preview overrides it below (otherwise a preview
  // deploy steals franklinjavier.com). www -> apex is a zone Redirect Rule.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#inheritable-keys
  // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
  "routes": [{ "pattern": "franklinjavier.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only page routes need the Worker (Markdown negotiation, redirects, Link
    // headers). Hashed bundles and images go straight to the asset CDN, like
    // the Vercel middleware matcher, which also skips paths with a dot.
    // Their headers come from public/_headers.
    // https://developers.cloudflare.com/workers/static-assets/binding/#run_worker_first
    "run_worker_first": ["/*", "!/_astro/*", "!/img/*", "!/images/*", "!/favicon.svg"],
    "not_found_handling": "404-page",
  },
  // blog-preview.imfrank.dev: a separate Worker deployed by its own Workers Builds
  // trigger (non-main branches, `npx wrangler deploy --env preview`, build var
  // SITE_URL=https://blog-preview.imfrank.dev). Production `blog` ignores this.
  // https://developers.cloudflare.com/workers/ci-cd/builds/advanced-setups/#wrangler-environments
  // https://developers.cloudflare.com/workers/wrangler/environments/
  "env": {
    "preview": {
      "name": "blog-preview",
      "routes": [{ "pattern": "blog-preview.imfrank.dev", "custom_domain": true }],
      "vars": { "ROBOTS": "noindex" },
    },
  },
}
