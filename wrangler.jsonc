{
  "name": "franklinjavier-blog",
  "main": "worker.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "build": { "command": "bun run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
}
