{
  "name": "blog",
  "main": "worker.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  // blog-preview.imfrank.dev: a separate Worker deployed by its own Workers Builds
  // trigger (non-main branches, `npx wrangler deploy --env preview`, build var
  // SITE_URL=https://blog-preview.imfrank.dev). Production `blog` ignores this.
  // https://developers.cloudflare.com/workers/ci-cd/builds/advanced-setups/#wrangler-environments
  // https://developers.cloudflare.com/workers/wrangler/environments/
  "env": {
    "preview": {
      "name": "blog-preview",
      "vars": { "ROBOTS": "noindex" },
    },
  },
}
