{
  "name": "franklinjavier",
  "version": "2.0.0",
  "description": "Franklin Javier's Personal Blog - Built with Astro + Tailwind",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run build && bun test tests",
    "test:cache": "bun test tests/diagram-cache.test.ts",
    "og": "bun scripts/og-cards.ts",
    "images:widths": "bun scripts/image-widths.ts",
    "updatedeps": "bun update --latest"
  },
  "author": "Franklin Javier <franklinjalves@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "vite": "^8.3.1"
  }
}
