{
  "taskPrefix": "BLOG",
  "integrationBranch": "next",
  "releaseBranch": "main",
  "remote": "origin",
  "stations": {
    "plan": {
      "family": [
        "codex",
        "claude"
      ]
    },
    "implement": {
      "family": [
        "codex",
        "claude"
      ]
    }
  },
  "flow": {
    "tweak": [
      "implement"
    ],
    "feature": [
      "plan",
      "implement"
    ],
    "risky": [
      "plan",
      "implement"
    ]
  },
  "setup": [
    "bun install --frozen-lockfile"
  ],
  "gates": {
    "quick": [
      "bun run test"
    ],
    "full": [
      "bun run test"
    ]
  },
  "risk": {
    "high": [
      "vercel.json",
      "middleware.ts",
      "astro.config.mjs",
      "package.json",
      "bun.lock",
      ".bottega/config.json"
    ],
    "medium": [
      "src/layouts/**",
      "src/lib/site.ts"
    ]
  },
  "promote": {
    "auto": false,
    "quietMinutes": 10
  },
  "gateTimeoutSec": 300,
  "plans": {
    "autoApprove": "unless-high-risk"
  },
  "deploy": {
    "kind": "vercel-git",
    "statusRepo": "franklinjavier/franklinjavier",
    "productionUrl": "https://franklinjavier.com",
    "smoke": [
      {
        "path": "/",
        "status": 200
      },
      {
        "path": "/pt-br/",
        "status": 200
      },
      {
        "path": "/pt-br/rss.xml",
        "status": 200
      },
      {
        "path": "/blog/which-is-the-best-os/",
        "status": 200,
        "accept": "text/markdown"
      }
    ],
    "observeMinutes": 10
  },
  "uiEvidence": [
    {
      "application": "franklinjavier-blog",
      "paths": [
        "src/components/Footer.astro",
        "src/components/Navigation.astro",
        "src/components/ThemeToggle.astro",
        "src/i18n/**"
      ],
      "verifySkill": ".agents/skills/verify-franklinjavier-blog/SKILL.md",
      "prototype": null,
      "journeys": [
        {
          "id": "footer-rss",
          "paths": [
            "src/components/Footer.astro",
            "src/i18n/ui.ts",
            "src/i18n/utils.ts"
          ],
          "states": [
            "default"
          ],
          "assertions": [
            "footer-rss-en",
            "footer-rss-pt",
            "footer-feed-locales",
            "footer-links-unchanged"
          ]
        },
        {
          "id": "header-controls",
          "paths": [
            "src/components/Navigation.astro",
            "src/components/ThemeToggle.astro",
            "src/i18n/ui.ts",
            "src/i18n/utils.ts"
          ],
          "states": [
            "default"
          ],
          "assertions": [
            "header-mobile-targets",
            "header-no-overflow",
            "header-theme-persistence",
            "header-locale-switch",
            "header-desktop-preserved"
          ]
        }
      ]
    }
  ]
}
