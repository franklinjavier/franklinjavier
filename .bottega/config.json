{
  "taskPrefix": "BLOG",
  "integrationBranch": "next",
  "releaseBranch": "main",
  "remote": "origin",
  "stations": {
    "plan": {
      "family": [
        "codex",
        "claude"
      ]
    },
    "implement": {
      "family": [
        "codex",
        "claude"
      ]
    }
  },
  "flow": {
    "tweak": [
      "implement"
    ],
    "feature": [
      "plan",
      "implement"
    ],
    "risky": [
      "plan",
      "implement"
    ]
  },
  "setup": [
    "bun install --frozen-lockfile"
  ],
  "gates": {
    "quick": [
      "bun run test"
    ],
    "full": [
      "bun run test"
    ]
  },
  "risk": {
    "high": [
      "vercel.json",
      "middleware.ts",
      "astro.config.mjs",
      "package.json",
      "bun.lock",
      ".bottega/config.json"
    ],
    "medium": [
      "src/layouts/**",
      "src/lib/site.ts"
    ]
  },
  "promote": {
    "auto": false,
    "quietMinutes": 10
  },
  "gateTimeoutSec": 300,
  "plans": {
    "autoApprove": "unless-high-risk"
  },
  "deploy": {
    "kind": "vercel-git",
    "statusRepo": "franklinjavier/franklinjavier",
    "productionUrl": "https://franklinjavier.com",
    "smoke": [
      {
        "path": "/",
        "status": 200
      },
      {
        "path": "/pt-br/",
        "status": 200
      },
      {
        "path": "/pt-br/rss.xml",
        "status": 200
      },
      {
        "path": "/blog/which-is-the-best-os/",
        "status": 200,
        "accept": "text/markdown"
      }
    ],
    "observeMinutes": 30
  }
}
